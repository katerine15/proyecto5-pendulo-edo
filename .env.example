# Copia este archivo a ".env" (en la raíz del proyecto). Todo es opcional.

# Si lo defines, la API exige el header "X-API-Key: <valor>" en /api/*  (excepto /api/health).
# Úsalo al publicar el dashboard por un túnel (Cloudflare) para que nadie más gaste tu equipo.
API_KEY=

# Verificación OPCIONAL por Ada (segunda opinión). Solo se aceptan direcciones de ESTE equipo (127.0.0.1 / localhost).
# Vacía = http://127.0.0.1:8100 (se enciende con scripts/start_ada_pendulum_api.ps1 del repositorio de Ada).
ADA_API_URL=

# Solo para el frontend en desarrollo (npm run dev): clave que el navegador envía a la API.
# Pónla también en frontend/.env.local como VITE_API_KEY=<mismo valor>
